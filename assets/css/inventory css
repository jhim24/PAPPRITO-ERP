/* ==========================================================
   PAPPRITO ERP
   INVENTORY MASTER CSS
   File: assets/css/inventory.css

   FEATURES:
   - Desktop Responsive
   - Mobile Responsive
   - Inventory Cards
   - Inventory Table
   - Filters
   - Stock Status
   - Modals
   - Stock In / Stock Out
   - Inventory Details
========================================================== */


/* ==========================================================
   ROOT
========================================================== */

.inventory-page {

    width: 100%;

    min-height: 100%;

    padding: 24px;

    background: #f3f4f6;

    color: #1f2937;

}


/* ==========================================================
   PAGE HEADER
========================================================== */

.inventory-page-header {

    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 20px;

    margin-bottom: 24px;

}


.inventory-page-label {

    display: inline-flex;

    align-items: center;

    gap: 7px;

    margin-bottom: 7px;

    color: #C8102E;

    font-size: 12px;

    font-weight: 700;

    letter-spacing: 0.08em;

}


.inventory-page-title h1 {

    margin: 0;

    color: #111827;

    font-size: 30px;

    font-weight: 800;

}


.inventory-page-title p {

    margin: 7px 0 0;

    color: #6b7280;

    font-size: 14px;

}


/* ==========================================================
   HEADER ACTIONS
========================================================== */

.inventory-header-actions {

    display: flex;

    align-items: center;

    justify-content: flex-end;

    gap: 10px;

    flex-wrap: wrap;

}


/* ==========================================================
   BUTTONS
========================================================== */

.inventory-btn {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    gap: 8px;

    min-height: 42px;

    padding: 0 16px;

    border: 1px solid transparent;

    border-radius: 9px;

    font-size: 13px;

    font-weight: 700;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease,
        transform 0.15s ease,
        box-shadow 0.2s ease;

}


.inventory-btn:hover {

    transform: translateY(-1px);

}


.inventory-btn:active {

    transform: scale(0.98);

}


.inventory-btn-primary {

    background: #C8102E;

    color: #ffffff;

    border-color: #C8102E;

}


.inventory-btn-primary:hover {

    background: #a80d26;

    border-color: #a80d26;

    color: #ffffff;

}


.inventory-btn-danger {

    background: #b91c1c;

    color: #ffffff;

    border-color: #b91c1c;

}


.inventory-btn-danger:hover {

    background: #991b1b;

    border-color: #991b1b;

}


.inventory-btn-secondary {

    background: #ffffff;

    color: #374151;

    border-color: #d1d5db;

}


.inventory-btn-secondary:hover {

    background: #f9fafb;

    border-color: #9ca3af;

}


/* ==========================================================
   ALERT
========================================================== */

.inventory-alert {

    display: flex;

    align-items: center;

    gap: 10px;

    width: 100%;

    margin-bottom: 20px;

    padding: 13px 16px;

    border-radius: 9px;

    font-size: 13px;

    font-weight: 600;

}


.inventory-alert.success {

    background: #ecfdf5;

    border: 1px solid #a7f3d0;

    color: #047857;

}


.inventory-alert.error {

    background: #fef2f2;

    border: 1px solid #fecaca;

    color: #b91c1c;

}


/* ==========================================================
   STATISTICS
========================================================== */

.inventory-stat-grid {

    display: grid;

    grid-template-columns:
        repeat(5, minmax(0, 1fr));

    gap: 15px;

    margin-bottom: 22px;

}


.inventory-stat-card {

    display: flex;

    align-items: center;

    gap: 13px;

    min-height: 105px;

    padding: 18px;

    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 12px;

    box-shadow:
        0 2px 8px rgba(0,0,0,0.04);

}


.inventory-stat-icon {

    display: flex;

    align-items: center;

    justify-content: center;

    flex: 0 0 46px;

    width: 46px;

    height: 46px;

    border-radius: 11px;

    font-size: 19px;

}


.inventory-stat-icon-items {

    background: #eff6ff;

    color: #2563eb;

}


.inventory-stat-icon-stock {

    background: #f0fdf4;

    color: #16a34a;

}


.inventory-stat-icon-low {

    background: #fffbeb;

    color: #d97706;

}


.inventory-stat-icon-out {

    background: #fef2f2;

    color: #dc2626;

}


.inventory-stat-icon-value {

    background: #f5f3ff;

    color: #7c3aed;

}


.inventory-stat-content {

    min-width: 0;

}


.inventory-stat-content span {

    display: block;

    margin-bottom: 5px;

    color: #6b7280;

    font-size: 12px;

    font-weight: 600;

}


.inventory-stat-content strong {

    display: block;

    overflow: hidden;

    color: #111827;

    font-size: 21px;

    font-weight: 800;

    text-overflow: ellipsis;

    white-space: nowrap;

}


/* ==========================================================
   TOOLBAR
========================================================== */

.inventory-toolbar {

    display: flex;

    align-items: center;

    gap: 10px;

    flex-wrap: wrap;

    margin-bottom: 16px;

    padding: 14px;

    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 12px;

}


.inventory-search {

    position: relative;

    flex: 1 1 280px;

    min-width: 220px;

}


.inventory-search i {

    position: absolute;

    top: 50%;

    left: 14px;

    color: #9ca3af;

    font-size: 13px;

    transform: translateY(-50%);

    pointer-events: none;

}


.inventory-search input {

    width: 100%;

    height: 42px;

    padding:
        0 14px 0 38px;

    background: #ffffff;

    border: 1px solid #d1d5db;

    border-radius: 8px;

    outline: none;

    color: #111827;

    font-size: 13px;

}


.inventory-search input:focus {

    border-color: #C8102E;

    box-shadow:
        0 0 0 3px
        rgba(200,16,46,0.10);

}


.inventory-filter {

    flex: 0 0 auto;

}


.inventory-filter select {

    width: 175px;

    height: 42px;

    padding:
        0 34px 0 12px;

    background-color: #ffffff;

    border: 1px solid #d1d5db;

    border-radius: 8px;

    outline: none;

    color: #374151;

    font-size: 13px;

    cursor: pointer;

}


.inventory-filter select:focus {

    border-color: #C8102E;

    box-shadow:
        0 0 0 3px
        rgba(200,16,46,0.10);

}


/* ==========================================================
   CARD
========================================================== */

.inventory-card,
.inventory-movement-card {

    width: 100%;

    margin-bottom: 20px;

    overflow: hidden;

    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 12px;

    box-shadow:
        0 2px 8px rgba(0,0,0,0.04);

}


.inventory-card-header {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    padding: 18px 20px;

    border-bottom: 1px solid #e5e7eb;

}


.inventory-card-header h2 {

    margin: 0;

    color: #111827;

    font-size: 17px;

    font-weight: 800;

}


.inventory-card-header p {

    margin: 4px 0 0;

    color: #6b7280;

    font-size: 12px;

}


.inventory-items-count {

    flex-shrink: 0;

    padding: 7px 11px;

    background: #f3f4f6;

    border-radius: 7px;

    color: #4b5563;

    font-size: 12px;

    font-weight: 700;

}


/* ==========================================================
   TABLE
========================================================== */

.inventory-table-wrapper {

    width: 100%;

    overflow-x: auto;

    -webkit-overflow-scrolling: touch;

}


.inventory-table {

    width: 100%;

    min-width: 1050px;

    border-collapse: collapse;

}


.inventory-table th {

    height: 45px;

    padding: 0 15px;

    background: #f9fafb;

    border-bottom: 1px solid #e5e7eb;

    color: #6b7280;

    font-size: 11px;

    font-weight: 800;

    letter-spacing: 0.03em;

    text-align: left;

    text-transform: uppercase;

    white-space: nowrap;

}


.inventory-table td {

    padding: 13px 15px;

    border-bottom: 1px solid #f1f5f9;

    color: #374151;

    font-size: 13px;

    vertical-align: middle;

}


.inventory-table tbody tr {

    transition:
        background 0.15s ease;

}


.inventory-table tbody tr:hover {

    background: #fafafa;

}


.inventory-table tbody tr:last-child td {

    border-bottom: none;

}


/* ==========================================================
   TABLE ITEM
========================================================== */

.inventory-item-code {

    color: #6b7280;

    font-family:
        Consolas,
        "Courier New",
        monospace;

    font-size: 12px;

    font-weight: 700;

}


.inventory-item-name {

    display: block;

    color: #111827;

    font-weight: 700;

}


.inventory-item-description {

    display: block;

    max-width: 220px;

    margin-top: 3px;

    overflow: hidden;

    color: #9ca3af;

    font-size: 11px;

    text-overflow: ellipsis;

    white-space: nowrap;

}


.inventory-category {

    color: #4b5563;

}


.inventory-unit {

    color: #6b7280;

    font-weight: 600;

}


.inventory-stock {

    color: #111827;

    font-weight: 800;

}


.inventory-reorder {

    color: #6b7280;

}


.inventory-cost {

    color: #374151;

    font-weight: 600;

}


.inventory-stock-value {

    color: #111827;

    font-weight: 800;

}


/* ==========================================================
   STATUS
========================================================== */

.inventory-status {

    display: inline-flex;

    align-items: center;

    gap: 6px;

    padding: 5px 9px;

    border-radius: 999px;

    font-size: 11px;

    font-weight: 800;

    white-space: nowrap;

}


.inventory-status::before {

    content: "";

    width: 6px;

    height: 6px;

    border-radius: 50%;

}


.inventory-status.in-stock {

    background: #ecfdf5;

    color: #047857;

}


.inventory-status.in-stock::before {

    background: #10b981;

}


.inventory-status.low-stock {

    background: #fffbeb;

    color: #b45309;

}


.inventory-status.low-stock::before {

    background: #f59e0b;

}


.inventory-status.out-of-stock {

    background: #fef2f2;

    color: #b91c1c;

}


.inventory-status.out-of-stock::before {

    background: #ef4444;

}


/* ==========================================================
   ACTIONS
========================================================== */

.inventory-actions {

    display: flex;

    align-items: center;

    gap: 5px;

}


.inventory-action-btn {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    width: 34px;

    height: 34px;

    padding: 0;

    background: #ffffff;

    border: 1px solid #e5e7eb;

    border-radius: 7px;

    color: #6b7280;

    cursor: pointer;

    transition:
        background 0.2s ease,
        border-color 0.2s ease,
        color 0.2s ease,
        transform 0.15s ease;

}


.inventory-action-btn:hover {

    transform: translateY(-1px);

}


.inventory-action-view:hover {

    background: #eff6ff;

    border-color: #bfdbfe;

    color: #2563eb;

}


.inventory-action-in:hover {

    background: #ecfdf5;

    border-color: #a7f3d0;

    color: #059669;

}


.inventory-action-out:hover {

    background: #fef2f2;

    border-color: #fecaca;

    color: #dc2626;

}


.inventory-action-adjust:hover {

    background: #f5f3ff;

    border-color: #ddd6fe;

    color: #7c3aed;

}


/* ==========================================================
   LOADING
========================================================== */

.inventory-loading {

    height: 150px;

    color: #6b7280 !important;

    text-align: center !important;

}


.inventory-loading span {

    display: block;

    margin-top: 10px;

}


.inventory-spinner {

    width: 25px;

    height: 25px;

    margin: 0 auto;

    border:
        3px solid #e5e7eb;

    border-top-color:
        #C8102E;

    border-radius: 50%;

    animation:
        inventorySpin 0.8s linear infinite;

}


@keyframes inventorySpin {

    to {

        transform: rotate(360deg);

    }

}


/* ==========================================================
   EMPTY STATE
========================================================== */

.inventory-empty {

    padding: 55px 20px !important;

    text-align: center !important;

}


.inventory-empty-icon {

    display: flex;

    align-items: center;

    justify-content: center;

    width: 55px;

    height: 55px;

    margin: 0 auto 13px;

    background: #f3f4f6;

    border-radius: 50%;

    color: #9ca3af;

    font-size: 21px;

}


.inventory-empty h4 {

    margin: 0 0 5px;

    color: #374151;

    font-size: 15px;

}


.inventory-empty p {

    margin: 0;

    color: #9ca3af;

    font-size: 12px;

}


/* ==========================================================
   PAGINATION
========================================================== */

.inventory-pagination {

    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 15px;

    padding: 14px 18px;

    border-top: 1px solid #e5e7eb;

}


.inventory-pagination-info {

    color: #6b7280;

    font-size: 12px;

}


.inventory-pagination-buttons {

    display: flex;

    align-items: center;

    gap: 5px;

}


.inventory-page-button {

    display: inline-flex;

    align-items: center;

    justify-content: center;

    min-width: 32px;

    height: 32px;

    padding: 0 8px;

    background: #ffffff;

    border: 1px solid #d1d5db;

    border-radius: 6px;

    color: #4b5563;

    font-size: 12px;

    font-weight: 700;

    cursor: pointer;

}


.inventory-page-button:hover {

    background: #f9fafb;

}


.inventory-page-button.active {

    background: #C8102E;

    border-color: #C8102E;

    color: #ffffff;

}


.inventory-page-button:disabled {

    opacity: 0.45;

    cursor: not-allowed;

}


/* ==========================================================
   MOVEMENT TABLE
========================================================== */

.inventory-movement-table {

    min-width: 750px;

}


.inventory-movement-in {

    color: #059669;

    font-weight: 800;

}


.inventory-movement-out {

    color: #dc2626;

    font-weight: 800;

}


.inventory-movement-adjustment {

    color: #7c3aed;

    font-weight: 800;

}


/* ==========================================================
   MODAL
========================================================== */

.inventory-modal {

    position: fixed;

    inset: 0;

    z-index: 5000;

    display: none;

    align-items: center;

    justify-content: center;

    padding: 20px;

    background:
        rgba(15,23,42,0.55);

}


.inventory-modal.show {

    display: flex;

}


.inventory-modal-dialog {

    width: 100%;

    max-width: 650px;

    max-height: calc(100vh - 40px);

    overflow: hidden;

    background: #ffffff;

    border-radius: 14px;

    box-shadow:
        0 20px 60px
        rgba(0,0,0,0.25);

    animation:
        inventoryModalIn
        0.2s ease;

}


.inventory-details-dialog {

    max-width: 850px;

}


@keyframes inventoryModalIn {

    from {

        opacity: 0;

        transform:
            translateY(10px)
            scale(0.98);

    }

    to {

        opacity: 1;

        transform:
            translateY(0)
            scale(1);

    }

}


/* ==========================================================
   MODAL HEADER
========================================================== */

.inventory-modal-header {

    display: flex;

    align-items: flex-start;

    justify-content: space-between;

    gap: 15px;

    padding: 18px 20px;

    border-bottom: 1px solid #e5e7eb;

}


.inventory-modal-label {

    display: block;

    margin-bottom: 4px;

    color: #C8102E;

    font-size: 10px;

    font-weight: 800;

    letter-spacing: 0.08em;

}


.inventory-modal-header h2 {

    margin: 0;

    color: #111827;

    font-size: 20px;

    font-weight: 800;

}


.inventory-modal-close {

    display: flex;

    align-items: center;

    justify-content: center;

    width: 36px;

    height: 36px;

    flex-shrink: 0;

    background: #f3f4f6;

    border: none;

    border-radius: 8px;

    color: #6b7280;

    cursor: pointer;

    transition:
        background 0.2s ease,
        color 0.2s ease;

}


.inventory-modal-close:hover {

    background: #fee2e2;

    color: #C8102E;

}


/* ==========================================================
   MODAL BODY
========================================================== */

.inventory-modal-body {

    max-height:
        calc(100vh - 180px);

    overflow-y: auto;

    padding: 20px;

}


.inventory-modal-body::-webkit-scrollbar {

    width: 6px;

}


.inventory-modal-body::-webkit-scrollbar-thumb {

    background: #d1d5db;

    border-radius: 10px;

}


/* ==========================================================
   FORM
========================================================== */

.inventory-form-grid {

    display: grid;

    grid-template-columns:
        repeat(2, minmax(0, 1fr));

    gap: 16px;

}


.inventory-form-group {

    min-width: 0;

}


.inventory-form-group-full {

    grid-column: 1 / -1;

}


.inventory-form-group label {

    display: block;

    margin-bottom: 7px;

    color: #374151;

    font-size: 12px;

    font-weight: 700;

}


.inventory-form-group input,
.inventory-form-group select,
.inventory-form-group textarea {

    width: 100%;

    padding: 10px 12px;

    background: #ffffff;

    border: 1px solid #d1d5db;

    border-radius: 8px;

    outline: none;

    color: #111827;

    font-family: inherit;

    font-size: 13px;

    transition:
        border-color 0.2s ease,
        box-shadow 0.2s ease;

}


.inventory-form-group input,
.inventory-form-group select {

    height: 42px;

}


.inventory-form-group textarea {

    min-height: 90px;

    resize: vertical;

}


.inventory-form-group input:focus,
.inventory-form-group select:focus,
.inventory-form-group textarea:focus {

    border-color: #C8102E;

    box-shadow:
        0 0 0 3px
        rgba(200,16,46,0.10);

}


/* ==========================================================
   MODAL FOOTER
========================================================== */

.inventory-modal-footer {

    display: flex;

    align-items: center;

    justify-content: flex-end;

    gap: 9px;

    padding: 15px 20px;

    border-top: 1px solid #e5e7eb;

}


/* ==========================================================
   DETAILS
========================================================== */

.inventory-details-grid {

    display: grid;

    grid-template-columns:
        repeat(3, minmax(0, 1fr));

    gap: 12px;

    margin-bottom: 25px;

}


.inventory-details-grid > div {

    padding: 14px;

    background: #f9fafb;

    border: 1px solid #e5e7eb;

    border-radius: 9px;

}


.inventory-details-grid span {

    display: block;

    margin-bottom: 5px;

    color: #6b7280;

    font-size: 11px;

    font-weight: 600;

}


.inventory-details-grid strong {

    display: block;

    overflow: hidden;

    color: #111827;

    font-size: 14px;

    font-weight: 800;

    text-overflow: ellipsis;

    white-space: nowrap;

}


.inventory-detail-history h3 {

    margin: 0 0 12px;

    color: #111827;

    font-size: 15px;

    font-weight: 800;

}


/* ==========================================================
   RESPONSIVE
========================================================== */

@media (max-width: 1200px) {

    .inventory-stat-grid {

        grid-template-columns:
            repeat(3, minmax(0, 1fr));

    }

}


@media (max-width: 992px) {

    .inventory-page {

        padding: 18px;

    }


    .inventory-page-header {

        flex-direction: column;

    }


    .inventory-header-actions {

        width: 100%;

        justify-content: flex-start;

    }


    .inventory-stat-grid {

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

    }


    .inventory-toolbar {

        align-items: stretch;

    }


    .inventory-search {

        flex-basis: 100%;

    }


    .inventory-filter {

        flex: 1 1 180px;

    }


    .inventory-filter select {

        width: 100%;

    }


    .inventory-details-grid {

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

    }

}


@media (max-width: 640px) {

    .inventory-page {

        padding: 12px;

    }


    .inventory-page-title h1 {

        font-size: 24px;

    }


    .inventory-page-title p {

        font-size: 12px;

        line-height: 1.5;

    }


    .inventory-header-actions {

        display: grid;

        grid-template-columns:
            repeat(2, minmax(0, 1fr));

        width: 100%;

    }


    .inventory-header-actions
    .inventory-btn {

        width: 100%;

    }


    .inventory-stat-grid {

        grid-template-columns:
            1fr;

        gap: 10px;

    }


    .inventory-stat-card {

        min-height: 82px;

        padding: 14px;

    }


    .inventory-stat-content strong {

        font-size: 19px;

    }


    .inventory-toolbar {

        padding: 10px;

    }


    .inventory-filter {

        flex-basis: 100%;

    }


    .inventory-card-header {

        align-items: flex-start;

        flex-direction: column;

        padding: 15px;

    }


    .inventory-card-header
    .inventory-btn {

        width: 100%;

    }


    .inventory-pagination {

        align-items: flex-start;

        flex-direction: column;

        padding: 12px 15px;

    }


    .inventory-pagination-buttons {

        width: 100%;

        overflow-x: auto;

        padding-bottom: 2px;

    }


    .inventory-modal {

        align-items: flex-end;

        padding: 0;

    }


    .inventory-modal-dialog {

        max-width: 100%;

        max-height: 92vh;

        border-radius:
            16px 16px 0 0;

    }


    .inventory-modal-body {

        max-height:
            calc(92vh - 145px);

        padding: 16px;

    }


    .inventory-form-grid {

        grid-template-columns: 1fr;

        gap: 13px;

    }


    .inventory-form-group-full {

        grid-column: auto;

    }


    .inventory-details-grid {

        grid-template-columns: 1fr;

    }


    .inventory-modal-footer {

        display: grid;

        grid-template-columns:
            1fr;

        padding: 12px 16px;

    }


    .inventory-modal-footer
    .inventory-btn {

        width: 100%;

    }

}


/* ==========================================================
   VERY SMALL MOBILE
========================================================== */

@media (max-width: 380px) {

    .inventory-page {

        padding: 9px;

    }


    .inventory-header-actions {

        grid-template-columns: 1fr;

    }


    .inventory-stat-card {

        padding: 12px;

    }


    .inventory-stat-icon {

        flex-basis: 40px;

        width: 40px;

        height: 40px;

    }

}
